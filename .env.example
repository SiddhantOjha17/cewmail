# Google Gemini (primary, free tier) -- get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (fallback only, used if Gemini fails -- no free tier, usage-based)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gmail SMTP + IMAP -- requires 2-Step Verification enabled, then an App Password
# (Google Account -> Security -> App Passwords -> generate one for "Mail")
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

FLASK_PORT=5000
